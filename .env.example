# 方舟 Agent Plan 的专属 API Key(ASR / TTS / LLM 共用)
# 获取: https://ark.volcengine.com/region:cn-beijing/subscription/agent-plan
VOLC_API_KEY=

# 插话判断用的 Jev(TypeSafe)。填了就用 Jev,不填则用下面的 LLM 做判断
# TYPESAFE_API_KEY=

# ---- 以下只影响 demo,都可以不填 ----
# LLM: 任意 OpenAI 兼容接口。不填则用 Agent Plan 的 doubao-seed-2.0-mini
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# TTS 音色
# TTS_SPEAKER=zh_female_vv_uranus_bigtts
